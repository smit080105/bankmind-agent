# Which LLM powers the Supervisor: "groq" (free, no card, recommended right
# now), "gemini" (free tier, but currently broken — see below), or
# "anthropic" (paid, needs credits).
LLM_PROVIDER=groq

# Groq (free, no credit card required) — get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
# NOTE: Groq moved llama-3.3-70b-versatile (and a few others) to
# Enterprise-only access as of mid/late 2026. gpt-oss-120b is confirmed
# free-tier + tool-calling capable as of this writing — check
# https://console.groq.com/docs/models if that ever changes.

# Gemini (Google AI Studio, free tier) — get a key at https://aistudio.google.com/apikey
# NOTE: as of late 2026, AI Studio only issues "AQ." keys, which have a
# widespread, unresolved Google-side bug rejecting them with "Expected
# OAuth 2 access token" on the standard API. Use Groq or Anthropic instead
# until Google fixes this.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.6-flash
# Workaround attempt: a Vertex AI Express Mode key instead of an AI Studio
# key, from https://console.cloud.google.com/vertex-ai (Express Mode
# signup) — not guaranteed, Vertex has its own setup friction.
# GEMINI_USE_VERTEX_EXPRESS=true

# Anthropic (optional — only needed if LLM_PROVIDER=anthropic, needs paid credits)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

DATABASE_PATH=data/customers.db
