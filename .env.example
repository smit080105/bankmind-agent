# Which LLM powers the Supervisor: "gemini" (free tier available) or "anthropic" (paid, needs credits)
LLM_PROVIDER=gemini

# Gemini (Google AI Studio, free tier) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (optional — only needed if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

DATABASE_PATH=data/customers.db
